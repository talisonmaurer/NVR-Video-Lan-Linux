[Unit]
Description=NVR Video LAN
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nvr-video-lan
Group=nvr-video-lan
StateDirectory=nvr-video-lan
StateDirectoryMode=0700
WorkingDirectory=/var/lib/nvr-video-lan
Environment=NVR_DATA=/var/lib/nvr-video-lan
Environment=NVR_FFMPEG=/usr/bin/ffmpeg
Environment=NVR_BIND=http://127.0.0.1:5088
Environment=NVR_SYSTEMD=1
EnvironmentFile=-/etc/nvr-video-lan/environment
ExecStart=/opt/nvr-video-lan/NvrVideoLan
Restart=always
RestartSec=3
TimeoutStopSec=120
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
